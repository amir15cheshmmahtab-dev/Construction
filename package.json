{
  "name": "sivan-marketplace",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "verify:pages": "node scripts/verify-pages.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:catalog": "node --test --test-isolation=none tests/catalog.test.mjs tests/catalog-routing.test.mjs",
    "test:products": "node --test --test-isolation=none tests/product-detail.test.mjs tests/cart.test.mjs tests/product-navigation.test.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs"
  },
  "dependencies": {
    "@peterbud/nuxt-query": "1.12.0",
    "@pinia/nuxt": "1.0.3",
    "@tanstack/vue-query": "5.105.0",
    "@vue/devtools-api": "8.2.1",
    "lucide-vue-next": "1.0.0",
    "nuxt": "4.5.2",
    "pinia": "4.1.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.15.2",
    "@tailwindcss/vite": "4.3.3",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "eslint-plugin-regexp": "3.1.0"
  }
}
